@startuml simd_optimization
title MicroLA SIMD Optimization Strategy

skinparam packageStyle rectangle
skinparam noteBackgroundColor lightyellow

package "SIMD Acceleration Tiers" {

    package "Tier 1: ARM NEON" <<Rectangle>> #lightblue {
        component "CONFIG_MICROLA_NEON" as neon #ADD8E6
        note right of neon
            **Platforms:**
            • ARM Cortex-A (Raspberry Pi, phones)
            • Apple Silicon (M1/M2/M3)
            • ARM64 (aarch64)

            **Implemented paths:**
            • Selected float Vec/Quaternion operations
            • Row-accumulating 4x4 matrix product
            • FMA where architecture supports it
            • Scale-safe normalization
            • No target speedup guarantee

            **Intrinsics:**
            vld1q_f32, vaddq_f32,
            vsubq_f32, vmulq_f32,
            vfmaq_f32 (FMA),
            vrecpeq_f32, vrsqrteq_f32
        end note
    }

    package "Tier 2: CMSIS-DSP" <<Rectangle>> #lightgreen {
        component "CONFIG_MICROLA_CMSIS" as cmsis #90EE90
        note right of cmsis
            **Platforms:**
            • ARM Cortex-M4F/M7/M33/M85
            • Microcontrollers (STM32, NXP, etc.)

            **DSP Functions:**
            **Vector ops:**
            arm_add_f32, arm_sub_f32
            arm_scale_f32, arm_negate_f32
            arm_dot_prod_f32

            **Matrix ops:**
            arm_mat_add_f32, arm_mat_sub_f32
            arm_mat_scale_f32, arm_mat_mult_f32
            arm_mat_trans_f32

            **Quaternion ops:**
            arm_quaternion_product_single_f32
            scalar-first storage adapter

            **Validation:**
            • Match dependency and target ABI
            • Measure latency and memory on target
            • No board timing or power claim

            **Benefits:**
            • Vendor-optimized for ARM Cortex-M
            • DSP instruction utilization
            • Hardware MAC (Multiply-Accumulate)
            • MicroLA adapter paths focus on float
        end note
    }

    package "Tier 1b: x86 AVX/AVX2" <<Rectangle>> #D6E6FF {
        component "CONFIG_MICROLA_AVX" as avx #D6E6FF
        note right of avx
            **Platforms:**
            • x86_64 (Intel/AMD)
            • AVX/AVX2 capable CPUs

            **Performance / Features:**
            • Wide 256-bit loads/stores (AVX)
            • AVX2 gather helper remains available
            • Generic float products use contiguous rows, not gathers
            • FMA via `vfmadd*`/`_mm_fmadd_ps`
            • High throughput for batched vector/matrix ops
        end note
    }

    package "Tier 3: RISC-V V Extensions" <<Rectangle>> #lightyellow {
        component "CONFIG_MICROLA_RISCV" as riscv #FFEB99
        note right of riscv
            **Platforms:**
            • RISC-V processors with V extensions

            **Experimental:**
            • Requires compatible intrinsic API
            • Scalar RV64GC compilation does not qualify RVV
            • No vector-target runtime or timing claim

            **Implementation:**
            RISC-V intrinsics are used directly in
            vector.hpp, matrix.hpp, and quaternion.hpp
            (NOT in simd_helpers.hpp).

            **Intrinsics:**
            vsetvl_e32m1 (set vector length)
            vle32_v_f32m1, vse32_v_f32m1 (load/store)
            vfadd_vv_f32m1, vfsub_vv_f32m1 (add/sub)
            vfmul_vv_f32m1, vfmul_vf_f32m1 (multiply)
            vfredsum_vs_f32m1_f32m1 (reduction)
        end note
    }

    package "Tier 4: Generic C++" <<Rectangle>> #lightcoral {
        component "Portable Scalar" as scalar #FFA07A
        note right of scalar
            **Platforms:**
            • Supported C++20 compilers
            • Fallback when no SIMD enabled

            **Implementation:**
            • std::fill_n, std::copy_n for bulk ops
            • Plain scalar loops
            • Compiler auto-vectorization friendly
            • constexpr compatible
            • Branch prediction hints

            **Always Available**
            Default for all platforms
        end note
    }
}

neon -down-> scalar : Disabled →
avx -down-> scalar : Disabled →
cmsis -down-> scalar : Disabled →
riscv -down-> scalar : Disabled →

package "Vec<float, N> Optimization" {
    rectangle "N=2: NEON float32x2_t / AVX __m128" as vec2 #E6F3FF
    rectangle "N=3: NEON float32x4_t (pad) / AVX __m128" as vec3 #E6F3FF
    rectangle "N=4: NEON float32x4_t / AVX __m128" as vec4 #E6F3FF

    note bottom of vec3
        **Optimized Layout:**
        Eliminated temporary arrays
        Direct SIMD register operations
        AVX via simd_helpers.hpp
        NEON via direct intrinsics
        Never read a padding byte as data[3]
    end note
}

neon --> vec2
neon --> vec3
neon --> vec4
avx --> vec4

package "Quaternion<float> Optimization" {
    rectangle "Full NEON multiply" as qmul #FFE6F0
    rectangle "Vec3 integration" as qvec3 #FFE6F0
    rectangle "Scale-safe normalization" as qslerp #FFE6F0

    note bottom of qmul
        **NEON Quaternion Product:**
        Selected architecture-specific operations
        Correctness/rounding checked separately from timing
    end note
}

neon --> qmul
neon --> qvec3
neon --> qslerp

package "Matrix Operations" {
    rectangle "Generic contiguous-row product" as mat3 #F0FFE6
    rectangle "NEON 4x4 row accumulation" as mat4 #F0FFE6
    rectangle "Non-float blocked product" as block #F0FFE6

    note bottom of mat3
        **Matrix SIMD:**
        Row-major optimized
        Inner column loop is contiguous
        No dedicated NEON 3x3 matrix-matrix kernel
        Paired row-reference benchmarks: 4/6/32/64
    end note
}

neon --> mat4
cmsis --> mat3
cmsis --> mat4

@enduml

