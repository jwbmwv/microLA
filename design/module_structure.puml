package "Optional SIMD Support" {
    component "CONFIG_MICROLA_NEON" as neon #ADD8E6
    component "CONFIG_MICROLA_CMSIS" as cmsis #90EE90
    component "CONFIG_MICROLA_RISCV" as riscv #FFEB99
    component "CONFIG_MICROLA_AVX" as avx #D6E6FF

    note bottom of neon
        **Enabled via:**
        #define CONFIG_MICROLA_NEON

        **Provides:**
        <arm_neon.h> intrinsics
        2-4× performance boost
    end note

    note bottom of cmsis
        **Enabled via:**
        #define CONFIG_MICROLA_CMSIS

        **Provides:**
        <arm_math.h> DSP functions
        Cortex-M optimizations
    end note

    note bottom of riscv
        **Enabled via:**
        #define CONFIG_MICROLA_RISCV

        **Provides:**
        <riscv_vector.h> intrinsics
        1.3-2× performance boost
        Variable-length vectors
    end note

    note bottom of avx
        **Enabled via:**
        #define CONFIG_MICROLA_AVX

        **Provides:**
        <immintrin.h> intrinsics
        256-bit loads/stores
        AVX2 gather instructions
    end note
}

