riscv ..> matrix : optimizes
riscv ..> quaternion : optimizes

package "Build Integration" {
    [CMakeLists.txt] as cmake #F5F5F5
    [vcpkg.json] as vcpkg #F5F5F5
    [conanfile.py] as conan #F5F5F5
    [west.yml] as zephyr #F5F5F5

    note bottom of cmake
        **Header-only library target**
        INTERFACE library (no compilation)
        Optional: examples, benchmarks
    end note
}

main ..> cmake : configured by
main ..> vcpkg : packaged by
main ..> conan : packaged by
main ..> zephyr : Zephyr module

@enduml

